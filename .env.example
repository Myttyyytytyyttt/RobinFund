# Copia este file a .env y rellena los valores. .env está gitignored — los secretos nunca se commitean.
RH_RPC_MAINNET=https://robinhood-mainnet.g.alchemy.com/v2/<TU_API_KEY>
RH_RPC_TESTNET=https://robinhood-testnet.g.alchemy.com/v2/<TU_API_KEY>
RH_CHAIN_ID_MAINNET=4663
RH_CHAIN_ID_TESTNET=46630
DEVNET_CHAIN_ID=31337
DEPLOYER_PK=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
WALLETCONNECT_PROJECT_ID=

# Nuvem Agents gateway (backend only unless explicitly marked public)
PUBLIC_BASE_URL=http://127.0.0.1:8787
PORT=8787
# Target efectivo del gateway/workers. Las variables MAINNET/TESTNET de arriba
# se conservan para scripts; producción debe inyectar este par explícitamente.
RH_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<TU_API_KEY>
RH_CHAIN_ID=4663
# Fail closed while Graph or the real execution venue is unavailable.
TRADING_ENABLED=true
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
WORLD_CHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/v2/<TU_API_KEY>
WORLD_DEVELOPER_API_KEY=
WORLD_AGENTBOOK_RELAY_URL=https://x402-worldchain.vercel.app
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ID_ACTION=sponsor-ai-vault
WORLD_VERIFY_BASE_URL=https://developer.worldcoin.org
# Optional override. The gateway derives staging for RH_CHAIN_ID=46630 and
# production otherwise; an explicit value must match the selected chain.
# WORLD_ID_ENVIRONMENT=staging
# Optional policy-specific action. It must already exist in the same World
# Developer Portal app; keep this equal to WORLD_ID_ACTION to reuse that action.
WORLD_IDENTITY_ACTION=sponsor-ai-vault
WORLD_IDENTITY_VERIFY_BASE_URL=https://developer.world.org
WORLD_IDENTITY_VERIFY_TIMEOUT_MS=10000
WORLD_IDENTITY_REQUEST_TTL_SECONDS=600
WORLD_IDENTITY_ATTESTATION_TTL_SECONDS=604800
AGENT_REGISTRY_ADDRESS=
USDG_ADDRESS=
GRAPH_URL=
GRAPH_DEPLOYMENT_ID=
# Standalone Substreams credentials for Robinhood Chain. Keep the JWT backend-only.
SUBSTREAMS_API_TOKEN=
SUBSTREAMS_ENDPOINT=robinhood.substreams.pinax.network:443
SUBGRAPH_START_BLOCK=
# Optional: write generated network addresses to a temporary file instead of packages/subgraph/networks.json
SUBGRAPH_NETWORKS_FILE=
UNISWAP_API_BASE_URL=https://trade-api.gateway.uniswap.org/v1
UNISWAP_API_KEY=
# Must equal the exact `swap.to` returned by a fresh no-Permit2 /swap probe for the target chain.
UNISWAP_APPROVAL_PROXY=
# Official chain-specific Universal Router forwarded to by the approval proxy.
UNISWAP_UNIVERSAL_ROUTER=
AGENT_SESSION_SECRET=
WORLD_ID_PEPPER=
# Development/canary derived signer root. Public production must use a KMS/HSM provider.
MANAGED_SIGNER_SECRET=
MAX_MANAGED_AGENTS_PER_HUMAN=3
WORLD_VERIFIER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
RELAYER_CONFIRMATIONS=2
WORKER_POLL_MS=2000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://nuvem.fund,https://www.nuvem.fund

# AI-vault deploy worker (backend only; request-driven on Vercel or durable loop elsewhere)
# Use a dedicated funded operator that owns FundRegistry. Contract artifacts are bundled at build time.
DEPLOY_OPERATOR_PRIVATE_KEY=
TOKEN_REGISTRY_ADDRESS=
ADAPTER_REGISTRY_ADDRESS=
ELIGIBILITY_GATE_ADDRESS=
GUARDIAN_ADDRESS=
FUND_REGISTRY_ADDRESS=
KEEPER_ADDRESS=
PROTOCOL_TREASURY_ADDRESS=
UNISWAP_API_ADAPTER_ADDRESS=
UNISWAP_API_ADAPTER_ID=
NAV_LIB_ADDRESS=0x26c6c76d7f9c17c5290e09406a2446dcd4605bcd
AGENT_ASSETS=
VAULT_WORKER_CONFIRMATIONS=2
VAULT_WORKER_POLL_MS=2000
