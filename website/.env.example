# Copy to website/.env for local development. In Vercel, use these exact VITE_* names and redeploy.
# VITE_* values are public browser configuration. Never prefix PRIVY_APP_SECRET or private keys with VITE_.
VITE_PRIVY_APP_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_INDEXER_GRAPHQL_URL=http://127.0.0.1:42069/graphql
VITE_RH_RPC_URL=http://127.0.0.1:8545
VITE_RH_CHAIN_ID=31337
VITE_VAULT_CREATOR_URL=http://127.0.0.1:8788
VITE_AGENT_GATEWAY_URL=http://127.0.0.1:8790
# Must equal backend WORLD_ID_ENVIRONMENT. Production is the safe default; for
# simulator testing set both sides to staging and use https://simulator.orb.engineer/.
VITE_WORLD_IDENTITY_ENVIRONMENT=production
VITE_AGENT_REGISTRY_ADDRESS=
# Comma-separated public allowlist used by the AI-vault policy wizard.
VITE_AGENT_ASSETS=
VITE_UNISWAP_API_ADAPTER_ADDRESS=
VITE_UNISWAP_API_ADAPTER_ID=
# Public mirror of the backend-pinned proxy. Set from the verified deployment output.
VITE_UNISWAP_APPROVAL_PROXY=
# Public mirror of the chain-specific router pinned by the adapter.
VITE_UNISWAP_UNIVERSAL_ROUTER=
# Public address only. The reference agent private key remains backend-only.
# Optional outside devnet: canonical FundRegistry used for direct onchain discovery.
VITE_FUND_REGISTRY_ADDRESS=
