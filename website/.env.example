# Copy to website/.env for local development. In Vercel, use these exact VITE_* names and redeploy.
# VITE_* values are public browser configuration. Never prefix PRIVY_APP_SECRET or private keys with VITE_.
VITE_PRIVY_APP_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_INDEXER_GRAPHQL_URL=http://127.0.0.1:42069/graphql
VITE_RH_RPC_URL=http://127.0.0.1:8545
VITE_RH_CHAIN_ID=31337
VITE_VAULT_CREATOR_URL=http://127.0.0.1:8788
# Optional outside devnet: canonical FundRegistry used for direct onchain discovery.
VITE_FUND_REGISTRY_ADDRESS=
