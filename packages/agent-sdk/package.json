{
  "name": "@nuvem/agent-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Model-neutral BYOA SDK and CLI for Nuvem AI vault managers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nuvem-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "python"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@worldcoin/agentkit": "^0.2.0",
    "viem": "2.55.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
