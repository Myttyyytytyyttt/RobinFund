{
  "name": "@nuvem/vault-intelligence-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only Graph-backed MCP server for Nuvem vault intelligence",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@modelcontextprotocol/sdk": "latest",
    "hono": "4.12.31",
    "viem": "2.55.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
