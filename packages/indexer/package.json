{
  "name": "@robinfund/indexer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Indexer Ponder de NuvemFund: fondos, depósitos/retiros, settlements y trades — API GraphQL para el frontend",
  "scripts": {
    "dev": "ponder dev",
    "start": "ponder start",
    "codegen": "ponder codegen",
    "gen-abis": "node scripts/gen-abis.mjs",
    "test": "vitest run",
    "test:e2e": "cross-env INDEXER_E2E=1 vitest run test/e2e.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "ponder": "^0.16.6",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
